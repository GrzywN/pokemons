{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    /* Bundler mode */
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
